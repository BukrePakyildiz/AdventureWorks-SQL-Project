CREATE TRIGGER trg_Employees_CascadeAgeIncrease
ON dbo.Employees
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;
 
    IF UPDATE(Age)
    BEGIN
        IF EXISTS (
            SELECT 1
            FROM inserted AS i
            JOIN deleted AS d ON i.ID = d.ID
            WHERE i.Age = d.Age + 1
        )
        BEGIN
            UPDATE e
            SET Age = Age + 1
            FROM dbo.Employees AS e
            WHERE e.ID NOT IN (SELECT ID FROM inserted);
        END
    END
END;
GO

